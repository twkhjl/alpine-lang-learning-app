# Copy this file to .env and fill in your real Stitch credentials.
# Never commit your real API key.

STITCH_API_KEY=your_stitch_api_key_here
STITCH_PROJECT_ID=your_stitch_project_id_here
STITCH_PROJECT_TITLE=Stitch Generated Page
# Optional. The generator always writes inside page_example/.
STITCH_OUTPUT=stitch-output.html
